# Copiá este archivo como .env (NO lo subas al repo).

# ── Dónde está el back (por defecto, el host de Docker) ──────────────────────
# Si corrés el front con `mvn spring-boot:run` (sin Docker) usá localhost.
# SERVICIOS_DONACIONES_URL=http://host.docker.internal:8081
# SERVICIOS_INCENTIVOS_URL=http://host.docker.internal:8083
# SERVICIOS_NOTIFICACIONES_URL=http://host.docker.internal:8084
# SERVICIOS_LOGISTICA_URL=http://host.docker.internal:8085
# SERVICIOS_AUTENTICACION_URL=http://host.docker.internal:8088

# ── Clave compartida con el back (obligatoria) ───────────────────────────────
# Al menos 32 caracteres (por ejemplo: openssl rand -hex 32). Tiene que ser la
# misma AUTH_FRONTEND_KEY que en donatrack/.env del back: sin ella no se pueden
# vincular perfiles ni activar cuentas.
AUTH_FRONTEND_KEY=

# ── Login con Google (opcional) ──────────────────────────────────────────────
# Google Cloud Console → APIs y servicios → Credenciales → ID de cliente OAuth (aplicación web).
# URI de redirección autorizada: <URL pública del front>/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
